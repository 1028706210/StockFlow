# 复制为本地 .env 后通过 Node --env-file-if-exists=.env 启动；不要把密钥放进聊天、源码或公开仓库。
HOST=127.0.0.1
PORT=8094
BASE_URL=http://127.0.0.1:8094
PAYMENTS_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-10-28.endive
# 以下正式参数默认保持未确认；仅地区/币种/定价/政策/测试均通过且获得授权后设置。
LIVE_PAYMENTS_APPROVED=no
LIVE_POLICIES_CONFIRMED=no
LIVE_REGION=
LIVE_CURRENCY=
LIVE_REVIEW_REFERENCE=
